# ============================================================
# PERSONAL OS — ENVIRONMENT VARIABLES EXAMPLE
# ============================================================
# Masukkan nilai-nilai ini ke pengaturan Vercel:
# Project Settings > Environment Variables
# (Berlaku untuk Production, Preview, dan Development)

# --- FIREBASE CONFIGURATION (Wajib untuk Auth & Firestore) ---
# Dapatkan dari: Firebase Console > Project Settings > General > Your apps (Web app </>)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# --- GOOGLE GEMINI AI CONFIGURATION (Wajib untuk AI Assistant & Brief) ---
# Dapatkan API key gratis dari: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Optional Vite/CRA Prefix if using a bundler (Supported for flexibility)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
