# ============================================================
# PERSONAL OS — ENVIRONMENT VARIABLES EXAMPLE
# ============================================================
# Masukkan nilai-nilai ini ke pengaturan Vercel:
# Project Settings > Environment Variables
# (Berlaku untuk Production, Preview, dan Development)

# --- FIREBASE CONFIGURATION (Wajib untuk Google Auth & Cloud Firestore) ---
# Dapatkan dari: Firebase Console > Project Settings > General > Your apps (Web app </>)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# --- GOOGLE GEMINI AI CONFIGURATION (Wajib untuk AI Assistant & Brief) ---
# Dapatkan API key gratis dari: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=AIzaSy...

# Format alternatif tanpa prefix NEXT_PUBLIC_ juga otomatis didukung:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
